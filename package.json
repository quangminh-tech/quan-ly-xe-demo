{
  "name": "van-tai-vue-node-json",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node server/server.js",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node server/server.js",
    "reset:demo": "node server/scripts/reset.js",
    "check": "node --check server/server.js && node --check server/services/report.service.js && node --check server/routes/reports.routes.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "vue": "^3.5.13",
    "lucide-vue-next": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "vite": "^6.0.5",
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20 <27"
  }
}
